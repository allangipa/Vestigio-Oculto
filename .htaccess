# Vestígio Oculto — configuração Apache (Hostinger)

ErrorDocument 404 /404.html

# HTTPS e domínio canônico: evita conteúdo duplicado aos olhos do Google
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Cache de longa duração para estáticos; HTML sempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# Compressão: as páginas têm CSS embutido e comprimem muito bem
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml
</IfModule>

# O diretório de fontes não precisa ser servido
<IfModule mod_rewrite.c>
  RewriteRule ^_src/ - [F,L]
</IfModule>
