# Vestígio Oculto — configuração Apache (Hostinger)

ErrorDocument 404 /404.html

# HTTPS e domínio canônico: evita conteúdo duplicado aos olhos do Google
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Cache de longa duração para estáticos; HTML sempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType image/webp      "access plus 1 year"
  ExpiresByType font/woff2      "access plus 1 year"
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# Alguns servidores ainda não conhecem estes dois de fábrica
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Compressão: as páginas têm CSS embutido e comprimem muito bem.
# woff2 e webp ficam de fora: já são comprimidos, e recomprimir só gasta CPU
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml
</IfModule>

# O diretório de código-fonte não é para ser servido
# (as fontes tipográficas ficam em /assets/fontes/, essas sim públicas)
<IfModule mod_rewrite.c>
  RewriteRule ^_src/ - [F,L]
</IfModule>
