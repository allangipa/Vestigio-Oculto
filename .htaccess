# Vestígio Oculto — configuração Apache (Hostinger)

ErrorDocument 404 /404.html

# Domínio principal: https://vestigiooculto.com, sem www (desde 03/10/2026).
# Os outros domínios estão estacionados neste mesmo site e servem os mesmos
# arquivos; aqui eles redirecionam 301, caminho a caminho e com a query string:
#   vestigiooculto.com.br e www.vestigiooculto.com.br -> https://vestigiooculto.com/<caminho>
#   www.vestigiooculto.com                            -> https://vestigiooculto.com/<caminho>
#   concealedpast.com e www.concealedpast.com         -> https://vestigiooculto.com/en/<caminho>
# No concealedpast, o que já está em /en/ não ganha um segundo /en/, e os
# arquivos que existem uma vez só para o site inteiro (imagens, fontes,
# favicon, robots, sitemap, ads.txt) vão para o mesmo caminho, sem /en/.
# Só os hosts listados: o domínio temporário da Hostinger fica como está.
# Teste sem servidor: python _src/testa_htaccess.py .htaccess
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?concealedpast\.com\.?(:\d+)?$ [NC]
  RewriteCond %{REQUEST_URI} ^/(en/|assets/|favicon\.svg$|robots\.txt$|sitemap\.xml$|ads\.txt$) [NC]
  RewriteRule ^ https://vestigiooculto.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?concealedpast\.com\.?(:\d+)?$ [NC]
  RewriteRule ^ https://vestigiooculto.com/en%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?vestigiooculto\.com\.br\.?(:\d+)?$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.vestigiooculto\.com\.?(:\d+)?$ [NC]
  RewriteRule ^ https://vestigiooculto.com%{REQUEST_URI} [R=301,L,NE]
  # http -> https no domínio principal, num salto só
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^vestigiooculto\.com\.?(:\d+)?$ [NC]
  RewriteRule ^ https://vestigiooculto.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Cache de longa duração para estáticos; HTML sempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType image/webp      "access plus 1 year"
  ExpiresByType font/woff2      "access plus 1 year"
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# Alguns servidores ainda não conhecem estes dois de fábrica
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Compressão: as páginas têm CSS embutido e comprimem muito bem.
# woff2 e webp ficam de fora: já são comprimidos, e recomprimir só gasta CPU
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml
</IfModule>

# O diretório de código-fonte não é para ser servido
# (as fontes tipográficas ficam em /assets/fontes/, essas sim públicas)
<IfModule mod_rewrite.c>
  RewriteRule ^_src/ - [F,L]
  # notas de trabalho em qualquer pasta (README, AUDITORIA, PROXIMOS, BAIXAR,
  # assets/img/CREDITOS.md…) e o .gitignore
  RewriteRule \.md$ - [F,L]
  RewriteRule ^\.git - [F,L]
</IfModule>
